# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_INITIAL_PASSWORD: Optional initial password for hashtnagarcrafts@gmail.com.
# If unset, the secure first-time setup wizard on /admin prompts the administrator to set their password.
ADMIN_INITIAL_PASSWORD=""

# ADMIN_EMAIL: Default administrator email address.
ADMIN_EMAIL="hashtnagarcrafts@gmail.com"

# Email Service Configuration (Optional)
# Configure an authenticated SMTP service or API for customer order alerts and password resets
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_EMAIL="hashtnagarcrafts@gmail.com"
